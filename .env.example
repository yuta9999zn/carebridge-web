# ===== CareBridge — biến môi trường production (VPS / Docker) =====
# Copy thành .env rồi điền giá trị thật:  cp .env.example .env

# --- Database (Postgres trong cùng docker network; host = tên service "postgres") ---
POSTGRES_PASSWORD=đổi_mật_khẩu_mạnh
DATABASE_URL=postgresql://cb_user:đổi_mật_khẩu_mạnh@postgres:5432/carebridge?schema=public

# --- Auth (NextAuth v5) ---
# Sinh bằng: openssl rand -base64 32
AUTH_SECRET=
# Mật khẩu admin mặc định khi tạo tài khoản đầu tiên.
ADMIN_PASSWORD=đổi_mật_khẩu_admin

# --- App ---
APP_URL=http://187.77.127.200:3200
NODE_ENV=production

# --- SMTP (tùy chọn — để trống SMTP_HOST sẽ bỏ qua gửi email) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ADMIN_NOTIFY_EMAIL=
